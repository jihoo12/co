// expect: [[0, 2, 4], [1, 3, 5, 99]]
// `x = append(x, v)` grows slices in place even inside slices and maps.
func main() {
    grid := [][]int{[]int{}, []int{}}
    for i := range 6 {
        grid[i % 2] = append(grid[i % 2], i)
    }
    j := 1
    grid[j] = append(grid[j], 99)
    println(grid)
}
