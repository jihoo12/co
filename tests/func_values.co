// Functions are values (function pointers), and C can call them back.
extern {
    func qsort(base *void, n uint64, size uint64, cmp func(a, b *void) int32)
    func abs(x int32) int32
}

type Button struct {
    label string
    onClick func(int) int
}

func byValue(a *void, b *void) int32 {
    unsafe {
        var x *int32 = a
        var y *int32 = b
        if *x < *y { return -1 }
        if *x > *y { return 1 }
    }
    return 0
}
func twice(x int) int { return x * 2 }
func inc(x int) int { return x + 1 }
func apply(f func(int) int, x int) int { return f(x) }
func pick(up bool) func(int) int {
    if up { return inc }
    return twice
}

func main() {
    nums := []int32{5, 3, 9, 1}
    qsort(nums, uint64(len(nums)), uint64(sizeof(int32)), byValue)
    println(nums)
    f := twice
    println(f(21), apply(inc, 1), pick(true)(10), pick(false)(10))
    b := Button{label: "ok", onClick: twice}
    println(b.onClick(4))
    var g func(int) int
    println(g == nil, f != nil)
    g = inc
    println(g(g(0)))
    h := abs
    println(h(-3))
}
// expect: [1, 3, 5, 9]
// expect: 42 2 11 20
// expect: 8
// expect: true true
// expect: 2
// expect: 3
