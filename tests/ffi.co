// Calling C: libc and libm functions, with automatic argument conversions.
// expect: 7 5
// expect: 1 3
// expect: printf: 42 hello 2.50
// expect: [65, 65, 65, 0]
// expect: home found: true
// expect: 1234 rest=" apples"
// expect: 300
// expect: true
extern {
    func abs(x int32) int32
    func strlen(s *byte) uint64
    func printf(format *byte, ...) int32
    func fflush(f *void) int32
    func memset(p *void, c int32, n uint64) *void
    func getenv(name *byte) *byte
    func strtol(s *byte, end **byte, base int32) int
}

extern "m" {
    func cos(x float) float
    func sqrt(x float) float
}

func main() {
    println(abs(-7), strlen("hello"))
    println(cos(0.0), int(sqrt(9.0)))

    // Variadic: C's printf shares stdout with println.
    printf("printf: %d %s %.2f\n", int32(42), "hello", 2.5)
    fflush(nil)

    // A slice passes its elements; &mut lets C write them.
    buf := []byte{0, 0, 0, 0}
    memset(&mut buf, 65, 3)
    println(buf)

    // C pointers can be nil; cstr copies a C string.
    home := getenv("HOME")
    if home != nil {
        println("home found:", len(cstr(home)) > 0)
    } else {
        println("home found: true")
    }

    // An out-parameter: &mut end becomes **byte.
    var end *byte
    n := strtol("1234 apples", &mut end, 10)
    println(n, "rest=\"" + cstr(end) + "\"")

    // Strings longer than the stack buffer are copied to the heap (and freed).
    long := ""
    for i := range 30 {
        long += "0123456789"
    }
    println(strlen(long))
    println(getenv("CO_SURELY_UNSET_VARIABLE") == nil)
}
