// expect: 6
// expect: ab
// expect: 10
type Acc struct { total int; log []string }
func (a mut Acc) add(n int) { a.total += n }
func (a Acc) last() string { return a.log[len(a.log)-1] }
func biggest(v []int) int {
    best := v[0]
    for i := range len(v) {
        if v[i] > best { best = v[i] }
    }
    return best
}
func main() {
    acc := Acc{}
    acc.add(1)
    acc.add(2)
    acc.add(3)
    println(acc.total)
    acc.log = append(acc.log, "a")
    acc.log = append(acc.log, "ab")
    l := acc.last()
    acc.log = append(acc.log, "c")    // l is a value of its own
    println(l)
    v := []int{3, 10, 7}
    println(biggest(v))
}
