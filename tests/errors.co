// expect: 42
// expect: 0
// expect: failed: age is empty
// expect: user ann 30
// expect: load failed: reading user: age is empty
// expect: ok(7) err(bad)
// expect: saved
// expect: none
type User struct { name string; age int }
func parseAge(s &string) !int {
    if len(s) == 0 {
        return error("age is empty")
    }
    if s == "thirty" { return 30 }
    return 42
}
func load(name &string, age &string) !User {
    a := parseAge(age) or -1
    if a < 0 {
        return error("reading user: age is empty")
    }
    n := try parseAge(age)        // passes the error on (not reached when empty)
    return User{name: clone(name), age: n}
}
func save(u &User) ! {
    if len(u.name) == 0 { return error("no name") }
    println("saved")
}
func firstChar(s &string) ?int {
    n := try lookup(s)            // try on an optional returns none
    return n
}
func lookup(s &string) ?int {
    if s == "a" { return 97 }
    return none
}
func main() {
    println(parseAge("x") or 0)
    println(parseAge("") or 0)
    switch parseAge("") {
    case ok(n):  println(n)
    case err(e): println("failed:", e)
    }
    switch load("ann", "thirty") {
    case ok(u):  println("user", u.name, u.age)
    case err(e): println(e)
    }
    switch load("bob", "") {
    case ok(u):  println(u)
    case err(e): println("load failed: " + e)
    }
    var good !int = 7
    var bad !int = error("bad")
    println(good, bad)
    u := User{name: "x"}
    switch save(u) {
    case ok:     
    case err(e): println(e)
    }
    println(firstChar("zz"))
}
