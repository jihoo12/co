type Shape enum {
    Circle(r int)
    Rect(w, h int)
}

func Area(s Shape) int {
    a := 0
    switch s {
    case Circle(r): a = 3 * square(r)
    case Rect(w, h): a = w * h
    }
    return a
}

// Far uses dist2, an unexported method declared in point.co.
func Far(p Point) bool { return p.dist2() > 100 }

func square(n int) int { return n * n }
