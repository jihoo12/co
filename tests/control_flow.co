// expect: 1 3 5 7 9
// expect: 4
// expect: 6
// expect: fizz buzz fizzbuzz
func main() {
    i := 0
    for i < 10 {
        if i%2 == 1 {
            print(i)
            if i < 9 { print(" ") }
        }
        i++
    }
    println()
    n := 0
    for {
        n++
        if n == 4 { break }
    }
    println(n)
    total := 0
    for k := 0; k < 5; k++ {
        if k == 2 { continue }
        if k > 3 && true || false { break }
        total += k
    }
    println(total + 2)
    a := "x"
    for j := 1; j <= 15; j++ {
        if j%15 == 0 {
            a = "fizzbuzz"
        } else if j%5 == 0 && j == 10 {
            a = a + " buzz"
        } else if j == 3 {
            a = "fizz"
        }
    }
    println("fizz buzz", a)
}
